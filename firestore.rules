rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check document (no PII)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // =========================================================
    // HARDENED PRIMITIVE HELPERS
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'medhabikashcochingc@gmail.com';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isVerifiedUser() && (
        isBootstrappedSuperAdmin() ||
        (hasUserDoc() && userDoc().status == 'active')
      );
    }

    function hasRole(allowedRoles) {
      return isActiveUser() && (
        isBootstrappedSuperAdmin() ||
        (hasUserDoc() && userDoc().role in allowedRoles)
      );
    }

    function isAdmin() {
      return hasRole(['super_admin', 'admin']);
    }

    function isAcademicLeadership() {
      return hasRole(['super_admin', 'admin', 'principal']);
    }

    function isStaffOperator() {
      return hasRole(['super_admin', 'admin', 'principal', 'staff']);
    }

    function isTeacher() {
      return hasRole(['super_admin', 'admin', 'principal', 'teacher']);
    }

    function isAccountant() {
      return hasRole(['super_admin', 'admin', 'accountant']);
    }

    function isLibrarian() {
      return hasRole(['super_admin', 'admin', 'principal', 'librarian']);
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isLinkedStudent(studentId) {
      return isActiveUser() && hasUserDoc() && (
        ('linkedStudentId' in userDoc() && userDoc().linkedStudentId == studentId) ||
        ('linkedStudentIds' in userDoc() && userDoc().linkedStudentIds is list && userDoc().linkedStudentIds.size() <= 10 && studentId in userDoc().linkedStudentIds)
      );
    }

    // =========================================================
    // VALIDATION BLUEPRINTS
    // =========================================================
    function isValidUserSelfCreate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'linkedStudentId', 'linkedStudentIds', 'linkedParentId', 'linkedTeacherId', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        isNonEmptyString(data.email, 3, 160) &&
        isNonEmptyString(data.displayName, 1, 120) &&
        (data.role == 'student' || (isBootstrappedSuperAdmin() && data.role == 'super_admin')) &&
        data.status == 'active' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidUserAdminWrite(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'linkedStudentId', 'linkedStudentIds', 'linkedParentId', 'linkedTeacherId', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isNonEmptyString(data.email, 3, 160) &&
        isNonEmptyString(data.displayName, 1, 120) &&
        data.role in ['super_admin', 'admin', 'principal', 'teacher', 'accountant', 'student', 'parent', 'librarian', 'staff'] &&
        data.status in ['active', 'deactivated'] &&
        data.updatedAt == request.time;
    }

    function isValidAdmissionCreate(data) {
      return data.keys().hasAll(['applicationNumber', 'studentName', 'applyingClass', 'academicSession', 'mobile', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'applicationNumber', 'studentName', 'dob', 'gender', 'fatherName', 'motherName',
          'guardianName', 'mobile', 'email', 'address', 'previousSchool', 'previousClass',
          'applyingClass', 'academicSession', 'learningMode', 'status', 'source',
          'photoUrl', 'documentUrls', 'reviewNotes', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.applicationNumber, 4, 40) &&
        isNonEmptyString(data.studentName, 2, 120) &&
        isNonEmptyString(data.applyingClass, 1, 60) &&
        isNonEmptyString(data.academicSession, 2, 40) &&
        isNonEmptyString(data.mobile, 6, 30) &&
        data.status == 'Pending' &&
        data.createdAt == request.time;
    }

    function isValidAdmissionAdminUpdate(data) {
      return data.keys().hasAll(['applicationNumber', 'studentName', 'applyingClass', 'academicSession', 'mobile', 'status']) &&
        data.keys().hasOnly([
          'applicationNumber', 'studentName', 'dob', 'gender', 'fatherName', 'motherName',
          'guardianName', 'mobile', 'email', 'address', 'previousSchool', 'previousClass',
          'applyingClass', 'academicSession', 'learningMode', 'status', 'source',
          'photoUrl', 'documentUrls', 'reviewNotes', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.studentName, 2, 120) &&
        data.status in ['Pending', 'Under Review', 'Approved', 'Rejected'] &&
        data.updatedAt == request.time;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['studentId', 'admissionNumber', 'rollNumber', 'name', 'classId', 'sessionId', 'status']) &&
        data.keys().hasOnly([
          'id', 'studentId', 'admissionNumber', 'rollNumber', 'name', 'fatherName', 'motherName',
          'dob', 'gender', 'classId', 'sectionId', 'sessionId', 'learningMode',
          'phone', 'address', 'photoUrl', 'studentUid', 'parentUid', 'status',
          'islamicProgress', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.studentId, 2, 40) &&
        isNonEmptyString(data.admissionNumber, 2, 40) &&
        isNonEmptyString(data.rollNumber, 1, 30) &&
        isNonEmptyString(data.name, 2, 120) &&
        isNonEmptyString(data.classId, 1, 64) &&
        isNonEmptyString(data.sessionId, 1, 64) &&
        data.status in ['active', 'transferred', 'archived'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'collectionName', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'collectionName', 'documentId', 'detail', 'createdAt']) &&
        data.actorUid == request.auth.uid &&
        isNonEmptyString(data.action, 2, 120) &&
        isNonEmptyString(data.collectionName, 2, 80) &&
        data.createdAt == request.time;
    }

    function isValidLmsProgress(data, progressId) {
      return data.keys().hasAll([
          'id', 'studentUid', 'studentId', 'courseId',
          'courseCompletionPercent', 'completedLessonIds',
          'unlockedLessonIds', 'passedLessonIds', 'lessonProgress'
        ]) &&
        data.id == progressId &&
        data.studentUid == request.auth.uid &&
        progressId == request.auth.uid + '_' + data.courseId &&
        isNonEmptyString(data.courseId, 1, 128) &&
        data.courseCompletionPercent is number &&
        data.courseCompletionPercent >= 0 &&
        data.courseCompletionPercent <= 100 &&
        data.completedLessonIds is list &&
        data.unlockedLessonIds is list &&
        data.passedLessonIds is list &&
        data.lessonProgress is map;
    }

    function isValidLibraryCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'subcategories', 'order', 'isActive']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'description', 'subcategories', 'order', 'isActive', 'updatedAt']) &&
        isNonEmptyString(data.id, 1, 128) &&
        isNonEmptyString(data.name, 1, 120) &&
        isNonEmptyString(data.slug, 1, 120) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        data.subcategories is list &&
        data.subcategories.size() <= 40 &&
        data.order is number &&
        data.isActive is bool;
    }

    function isValidLibraryBook(data, bookId) {
      return data.keys().hasAll([
          'id', 'title', 'author', 'language', 'categoryId', 'categoryName',
          'permission', 'status', 'featured', 'pdfUrl', 'viewsCount', 'downloadsCount'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'author', 'publisher', 'language', 'categoryId', 'categoryName',
          'subcategory', 'description', 'tags', 'publicationYear', 'permission', 'status',
          'featured', 'pdfUrl', 'pdfStoragePath', 'coverUrl', 'coverStoragePath',
          'fileSizeBytes', 'pageCount', 'viewsCount', 'downloadsCount', 'searchText',
          'ocrRequired', 'uploadedByUid', 'uploadedByName', 'isSampleBook', 'createdAt', 'updatedAt'
        ]) &&
        data.id == bookId &&
        isNonEmptyString(data.title, 1, 240) &&
        isNonEmptyString(data.author, 1, 160) &&
        (!('publisher' in data) || (data.publisher is string && data.publisher.size() <= 160)) &&
        data.language in ['Bengali', 'Arabic', 'English', 'Urdu', 'Other'] &&
        isNonEmptyString(data.categoryId, 1, 128) &&
        isNonEmptyString(data.categoryName, 1, 120) &&
        (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('publicationYear' in data) || (data.publicationYear is string && data.publicationYear.size() <= 20)) &&
        data.permission in ['read_only', 'download', 'both'] &&
        data.status in ['published', 'draft'] &&
        data.featured is bool &&
        isNonEmptyString(data.pdfUrl, 1, 1000) &&
        (!('pdfStoragePath' in data) || (data.pdfStoragePath is string && data.pdfStoragePath.size() <= 500)) &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000)) &&
        (!('coverStoragePath' in data) || (data.coverStoragePath is string && data.coverStoragePath.size() <= 500)) &&
        (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0)) &&
        (!('pageCount' in data) || (data.pageCount is number && data.pageCount >= 0)) &&
        data.viewsCount is number && data.viewsCount >= 0 &&
        data.downloadsCount is number && data.downloadsCount >= 0 &&
        (!('searchText' in data) || (data.searchText is string && data.searchText.size() <= 30000)) &&
        (!('ocrRequired' in data) || data.ocrRequired is bool);
    }

    function isValidLibraryReadingProgress(data, progressId) {
      return data.keys().hasAll(['id', 'userUid', 'bookId', 'lastPage', 'totalPages']) &&
        data.keys().hasOnly(['id', 'userUid', 'bookId', 'lastPage', 'totalPages', 'zoom', 'updatedAt']) &&
        data.id == progressId &&
        data.userUid == request.auth.uid &&
        progressId == request.auth.uid + '_' + data.bookId &&
        isNonEmptyString(data.bookId, 1, 128) &&
        data.lastPage is number && data.lastPage >= 1 &&
        data.totalPages is number && data.totalPages >= 1 &&
        (!('zoom' in data) || (data.zoom is number && data.zoom >= 0.5 && data.zoom <= 3.0));
    }

    // =========================================================
    // USERS, ROLES & PERMISSIONS
    // =========================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSignedIn() && request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserSelfCreate(incoming(), userId);
      allow update: if isValidId(userId) && (
        (isAdmin() && isValidUserAdminWrite(incoming(), userId)) ||
        (
          isVerifiedUser() &&
          request.auth.uid == userId &&
          isValidUserAdminWrite(incoming(), userId) &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /roles/{roleId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(roleId) && isAdmin();
    }

    match /permissions/{permissionId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(permissionId) && isAdmin();
    }

    // =========================================================
    // PUBLIC WEBSITE & INSTITUTION SETTINGS (CMS)
    // =========================================================
    match /institutionSettings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId) && isAcademicLeadership();
    }

    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (existing().isPublic == true || isActiveUser());
      allow list: if existing().isPublic == true || isActiveUser();
      allow create, update, delete: if isValidId(noticeId) && isStaffOperator();
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().isPublic == true || isActiveUser());
      allow list: if existing().isPublic == true || isActiveUser();
      allow create, update, delete: if isValidId(eventId) && isStaffOperator();
    }

    match /gallery/{galleryId} {
      allow get: if isValidId(galleryId) && (existing().isPublic == true || isActiveUser());
      allow list: if existing().isPublic == true || isActiveUser();
      allow create, update, delete: if isValidId(galleryId) && isStaffOperator();
    }

    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && (existing().isPublic == true || isActiveUser());
      allow list: if existing().isPublic == true || isActiveUser();
      allow create, update, delete: if isValidId(teacherId) && isAcademicLeadership();
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId) && (existing().isPublic == true || isActiveUser());
      allow list: if existing().isPublic == true || isActiveUser();
      allow create, update, delete: if isValidId(courseId) && isTeacher();
    }

    // =========================================================
    // ADMISSIONS
    // =========================================================
    match /admissions/{admissionId} {
      allow get: if isValidId(admissionId) && isStaffOperator();
      allow list: if isStaffOperator();
      allow create: if isValidId(admissionId) && isValidAdmissionCreate(incoming());
      allow update: if isValidId(admissionId) && isStaffOperator() && isValidAdmissionAdminUpdate(incoming()) &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(admissionId) && isAdmin();
    }

    // =========================================================
    // STUDENTS, PARENTS & CONFIDENTIAL STAFF
    // =========================================================
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isTeacher() ||
        isAccountant() ||
        isStaffOperator() ||
        (isActiveUser() && (existing().studentUid == request.auth.uid || existing().parentUid == request.auth.uid)) ||
        isLinkedStudent(studentId)
      );
      allow list: if isTeacher() || isAccountant() || isStaffOperator() ||
        (isActiveUser() && (existing().studentUid == request.auth.uid || existing().parentUid == request.auth.uid));
      allow create, update: if isValidId(studentId) && isAcademicLeadership() && isValidStudent(incoming());
      allow delete: if isValidId(studentId) && isAdmin();
    }

    match /parents/{parentId} {
      allow get: if isValidId(parentId) && (isStaffOperator() || (isActiveUser() && existing().uid == request.auth.uid));
      allow list: if isStaffOperator() || (isActiveUser() && existing().uid == request.auth.uid);
      allow create, update, delete: if isValidId(parentId) && isStaffOperator();
    }

    match /staff/{staffId} {
      allow get, list: if isAdmin() || isAccountant();
      allow create, update, delete: if isValidId(staffId) && isAdmin();
    }

    // =========================================================
    // ACADEMICS: SESSIONS, CLASSES, SECTIONS, SUBJECTS, ENROLLMENTS
    // =========================================================
    match /academicSessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(sessionId) && isAcademicLeadership();
    }

    match /classes/{classId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(classId) && isAcademicLeadership();
    }

    match /sections/{sectionId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(sectionId) && isAcademicLeadership();
    }

    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(subjectId) && isAcademicLeadership();
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if isTeacher() || isStaffOperator() ||
        (isActiveUser() && (isLinkedStudent(existing().studentId) || existing().parentUid == request.auth.uid));
      allow create, update, delete: if isValidId(enrollmentId) && isAcademicLeadership();
    }

    // =========================================================
    // ATTENDANCE & TIMETABLES
    // =========================================================
    match /attendance/{attendanceId} {
      allow get, list: if isTeacher() || isStaffOperator() ||
        (isActiveUser() && (isLinkedStudent(existing().targetId) || existing().targetId == request.auth.uid || existing().parentUid == request.auth.uid));
      allow create, update: if isValidId(attendanceId) && isTeacher();
      allow delete: if isValidId(attendanceId) && isAdmin();
    }

    match /timetables/{timetableId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(timetableId) && isAcademicLeadership();
    }

    // =========================================================
    // HOMEWORK, ASSIGNMENTS, SUBMISSIONS & LMS
    // =========================================================
    match /homework/{homeworkId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(homeworkId) && isTeacher();
    }

    match /assignments/{assignmentId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(assignmentId) && isTeacher();
    }

    match /submissions/{submissionId} {
      allow get, list: if isTeacher() || (isActiveUser() && existing().studentUid == request.auth.uid);
      allow create: if isValidId(submissionId) && isActiveUser() && incoming().studentUid == request.auth.uid;
      allow update: if isValidId(submissionId) && (
        isTeacher() ||
        (isActiveUser() && existing().studentUid == request.auth.uid && incoming().studentUid == existing().studentUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['submissionText', 'fileUrl', 'status']))
      );
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    match /lessons/{lessonId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(lessonId) && isTeacher();
    }

    // Instructor-only MCQ answer bank (students never read answer keys directly)
    match /lmsQuestionBanks/{lessonId} {
      allow get: if isValidId(lessonId) && isTeacher();
      allow list: if isTeacher();
      allow create, update, delete: if isValidId(lessonId) && isTeacher();
    }

    // Student sequential LMS video progress, watch completion & quiz results
    match /lmsProgress/{progressId} {
      allow get: if isValidId(progressId) && (
        isTeacher() ||
        (isActiveUser() && (existing().studentUid == request.auth.uid || isLinkedStudent(existing().studentId)))
      );
      allow list: if isTeacher() ||
        (isActiveUser() && (existing().studentUid == request.auth.uid || isLinkedStudent(existing().studentId)));
      allow create: if isValidId(progressId) && isActiveUser() && isValidLmsProgress(incoming(), progressId);
      allow update: if isValidId(progressId) && isActiveUser() && isValidLmsProgress(incoming(), progressId) &&
        existing().studentUid == request.auth.uid && incoming().studentUid == existing().studentUid;
      allow delete: if isValidId(progressId) && isAdmin();
    }

    // Lesson Q&A entries
    match /lmsQa/{qaId} {
      allow get, list: if isActiveUser();
      allow create: if isValidId(qaId) && isActiveUser() &&
        incoming().authorUid == request.auth.uid &&
        isNonEmptyString(incoming().question, 3, 1500);
      allow update: if isValidId(qaId) && isTeacher();
      allow delete: if isValidId(qaId) && (
        isTeacher() ||
        (isActiveUser() && existing().authorUid == request.auth.uid)
      );
    }

    match /liveClasses/{liveClassId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(liveClassId) && isTeacher();
    }

    match /learningMaterials/{materialId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(materialId) && isTeacher();
    }

    match /library/{libraryId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(libraryId) && (isLibrarian() || isTeacher());
    }

    // As-Siddique Digital Islamic Library (published books readable by visitors/students; drafts private to Admin/Librarian)
    match /libraryCategories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isLibrarian() && isValidLibraryCategory(incoming());
      allow delete: if isValidId(categoryId) && isLibrarian();
    }

    match /libraryBooks/{bookId} {
      allow get: if isValidId(bookId) && (existing().status == 'published' || isLibrarian());
      allow list: if existing().status == 'published' || isLibrarian();
      allow create: if isValidId(bookId) && isLibrarian() && isValidLibraryBook(incoming(), bookId);
      allow update: if isValidId(bookId) && isLibrarian() && isValidLibraryBook(incoming(), bookId);
      allow delete: if isValidId(bookId) && isLibrarian();
    }

    match /libraryReadingProgress/{progressId} {
      allow get: if isValidId(progressId) && (
        isAdmin() ||
        (isActiveUser() && existing().userUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isActiveUser() && existing().userUid == request.auth.uid);
      allow create: if isValidId(progressId) && isActiveUser() && isValidLibraryReadingProgress(incoming(), progressId);
      allow update: if isValidId(progressId) && isActiveUser() && isValidLibraryReadingProgress(incoming(), progressId) &&
        existing().userUid == request.auth.uid && incoming().userUid == existing().userUid;
      allow delete: if isValidId(progressId) && (
        isAdmin() ||
        (isActiveUser() && existing().userUid == request.auth.uid)
      );
    }

    // =========================================================
    // EXAMINATIONS, MARKS & PUBLIC APPROVED RESULTS
    // =========================================================
    match /examinations/{examId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(examId) && isAcademicLeadership();
    }

    match /marks/{markId} {
      allow get, list: if isTeacher() || isAcademicLeadership();
      allow create, update: if isValidId(markId) && isTeacher();
      allow delete: if isValidId(markId) && isAcademicLeadership();
    }

    match /results/{resultId} {
      allow get: if isValidId(resultId) && (existing().isPublished == true || isTeacher());
      allow list: if existing().isPublished == true || isTeacher();
      allow create, update, delete: if isValidId(resultId) && isAcademicLeadership();
    }

    // =========================================================
    // FEES, INVOICES, PAYMENTS & CERTIFICATES
    // =========================================================
    match /feeStructures/{structureId} {
      allow get, list: if isActiveUser();
      allow create, update, delete: if isValidId(structureId) && isAccountant();
    }

    match /invoices/{invoiceId} {
      allow get, list: if isAccountant() || isAdmin() ||
        (isActiveUser() && (isLinkedStudent(existing().studentId) || existing().parentUid == request.auth.uid));
      allow create, update, delete: if isValidId(invoiceId) && isAccountant();
    }

    match /payments/{paymentId} {
      allow get, list: if isAccountant() || isAdmin() ||
        (isActiveUser() && (isLinkedStudent(existing().studentId) || existing().parentUid == request.auth.uid));
      allow create, update, delete: if isValidId(paymentId) && isAccountant();
    }

    match /certificates/{certificateId} {
      allow get, list: if isStaffOperator() ||
        (isActiveUser() && (isLinkedStudent(existing().studentId) || existing().parentUid == request.auth.uid));
      allow create, update, delete: if isValidId(certificateId) && isStaffOperator();
    }

    // =========================================================
    // NOTIFICATIONS & IMMUTABLE AUDIT LOGS
    // =========================================================
    match /notifications/{notificationId} {
      allow get, list: if isStaffOperator() ||
        (isActiveUser() && (
          existing().targetUid == request.auth.uid ||
          existing().targetRole == 'all' ||
          (hasUserDoc() && existing().targetRole == userDoc().role)
        ));
      allow create: if isTeacher() || isStaffOperator() || isAccountant() || isLibrarian();
      allow update: if isValidId(notificationId) && isActiveUser() &&
        (existing().targetUid == request.auth.uid || isStaffOperator()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin() || isAcademicLeadership();
      allow create: if isValidId(logId) && isActiveUser() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
