rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }

    // Public admission document uploads (validated size & type)
    match /admissions/{applicationId}/{fileName} {
      allow create: if isValidUpload();
      allow read: if isSignedIn();
    }

    // Digital library & study materials
    match /library/public/{bookId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        (
          (request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType == 'application/pdf') ||
          (request.resource.size <= 5 * 1024 * 1024 && (
            request.resource.contentType == 'image/jpeg' ||
            request.resource.contentType == 'image/png' ||
            request.resource.contentType == 'image/webp'
          ))
        );
      allow delete: if isSignedIn();
    }

    match /library/drafts/{bookId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        (
          (request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType == 'application/pdf') ||
          (request.resource.size <= 5 * 1024 * 1024 && (
            request.resource.contentType == 'image/jpeg' ||
            request.resource.contentType == 'image/png' ||
            request.resource.contentType == 'image/webp'
          ))
        );
      allow delete: if isSignedIn();
    }

    match /library/{resourceId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidUpload();
    }

    match /materials/{materialId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidUpload();
    }

    // Student & gallery media
    match /students/{studentId}/{fileName} {
      allow read, write: if isSignedIn() && isValidUpload();
    }

    match /gallery/{itemId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidUpload();
    }

    // Faculty profile photos (JPG, JPEG, PNG, WEBP up to 5 MB)
    match /teachers/{teacherId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        (
          request.resource.contentType == 'image/jpeg' ||
          request.resource.contentType == 'image/png' ||
          request.resource.contentType == 'image/webp'
        );
      allow delete: if isSignedIn();
    }

    // LMS video lectures uploaded by authorized faculty/admin (up to 150 MB)
    match /lmsVideos/{courseId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        request.resource.size <= 150 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isSignedIn();
    }
  }
}
