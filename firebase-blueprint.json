{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user account and RBAC role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "principal", "teacher", "accountant", "student", "parent", "librarian", "staff"]
        },
        "status": { "type": "string", "enum": ["active", "deactivated"] },
        "linkedStudentId": { "type": "string", "maxLength": 128 },
        "linkedParentId": { "type": "string", "maxLength": 128 },
        "linkedTeacherId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "RoleDefinition": {
      "title": "RoleDefinition",
      "description": "Configurable RBAC role metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "permissions": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "label", "permissions"]
    },
    "PermissionItem": {
      "title": "PermissionItem",
      "description": "Granular system permission record.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 80 },
        "module": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 }
      },
      "required": ["key", "module"]
    },
    "InstitutionSettings": {
      "title": "InstitutionSettings",
      "description": "Configurable public institution profile and CMS content.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 160 },
        "boardName": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 160 },
        "registrationNote": { "type": "string", "maxLength": 240 },
        "heroHeadline": { "type": "string", "maxLength": 200 },
        "heroSubtext": { "type": "string", "maxLength": 600 },
        "aboutContent": { "type": "string", "maxLength": 3000 },
        "visionText": { "type": "string", "maxLength": 1500 },
        "missionText": { "type": "string", "maxLength": 1500 },
        "principalName": { "type": "string", "maxLength": 120 },
        "principalMessage": { "type": "string", "maxLength": 3000 },
        "footerNote": { "type": "string", "maxLength": 400 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "tagline", "location", "boardName"]
    },
    "AdmissionApplication": {
      "title": "AdmissionApplication",
      "description": "Online or offline student admission request.",
      "type": "object",
      "properties": {
        "applicationNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dob": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "fatherName": { "type": "string", "maxLength": 120 },
        "motherName": { "type": "string", "maxLength": 120 },
        "guardianName": { "type": "string", "maxLength": 120 },
        "mobile": { "type": "string", "minLength": 6, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 400 },
        "previousSchool": { "type": "string", "maxLength": 160 },
        "previousClass": { "type": "string", "maxLength": 60 },
        "applyingClass": { "type": "string", "maxLength": 60 },
        "academicSession": { "type": "string", "maxLength": 40 },
        "learningMode": { "type": "string", "enum": ["Offline School", "Online Classes", "Hybrid Learning"] },
        "status": { "type": "string", "enum": ["Pending", "Under Review", "Approved", "Rejected"] },
        "source": { "type": "string", "enum": ["online", "offline"] },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "documentUrls": { "type": "array" },
        "reviewNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicationNumber", "studentName", "applyingClass", "academicSession", "mobile", "status", "createdAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Enrolled student academic and dual-education record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 40 },
        "admissionNumber": { "type": "string", "maxLength": 40 },
        "rollNumber": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 120 },
        "fatherName": { "type": "string", "maxLength": 120 },
        "motherName": { "type": "string", "maxLength": 120 },
        "dob": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "classId": { "type": "string", "maxLength": 64 },
        "sectionId": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "learningMode": { "type": "string", "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 400 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "parentUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "transferred", "archived"] },
        "islamicProgress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "admissionNumber", "rollNumber", "name", "classId", "sessionId", "status"]
    },
    "ParentRecord": {
      "title": "ParentRecord",
      "description": "Verified parent/guardian profile linked to students.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 160 },
        "studentIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "studentIds"]
    },
    "TeacherRecord": {
      "title": "TeacherRecord",
      "description": "Faculty profile visible across academic modules.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "designation": { "type": "string", "maxLength": 120 },
        "qualification": { "type": "string", "maxLength": 200 },
        "department": { "type": "string", "enum": ["general", "islamic", "both"] },
        "assignedClasses": { "type": "array" },
        "assignedSubjects": { "type": "array" },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 160 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "isPublic": { "type": "boolean" },
        "bio": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["active", "on_leave", "inactive"] }
      },
      "required": ["name", "designation", "department", "status"]
    },
    "StaffRecord": {
      "title": "StaffRecord",
      "description": "Confidential administrative staff and payroll metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "roleTitle": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 30 },
        "salaryAmount": { "type": "number" },
        "joinDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "roleTitle", "status"]
    },
    "AcademicSession": {
      "title": "AcademicSession",
      "description": "Academic year configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 40 },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "isActive"]
    },
    "AcademicClass": {
      "title": "AcademicClass",
      "description": "Class 1 to Class 12 structure.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "order": { "type": "number" },
        "wing": { "type": "string", "enum": ["Primary", "Upper Primary", "Secondary", "Higher Secondary"] },
        "boardTrack": { "type": "string", "maxLength": 80 },
        "classTeacherId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "order", "wing"]
    },
    "SectionRecord": {
      "title": "SectionRecord",
      "description": "Section inside a class.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 40 },
        "classId": { "type": "string", "maxLength": 64 },
        "capacity": { "type": "number" },
        "classTeacherId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "classId"]
    },
    "SubjectRecord": {
      "title": "SubjectRecord",
      "description": "Configurable General or Islamic Education subject.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "code": { "type": "string", "maxLength": 30 },
        "track": { "type": "string", "enum": ["general", "islamic"] },
        "classId": { "type": "string", "maxLength": 64 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "fullMarks": { "type": "number" },
        "passMarks": { "type": "number" },
        "isOptional": { "type": "boolean" }
      },
      "required": ["name", "track", "classId"]
    },
    "EnrollmentRecord": {
      "title": "EnrollmentRecord",
      "description": "Student enrollment for a session and class.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "sectionId": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["enrolled", "promoted", "transferred"] }
      },
      "required": ["studentId", "classId", "sessionId", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily student or teacher attendance entry.",
      "type": "object",
      "properties": {
        "targetType": { "type": "string", "enum": ["student", "teacher"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetName": { "type": "string", "maxLength": 120 },
        "classId": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Present", "Absent", "Late", "Leave"] },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 300 }
      },
      "required": ["targetType", "targetId", "date", "status"]
    },
    "TimetableSlot": {
      "title": "TimetableSlot",
      "description": "Class/teacher/room/online weekly schedule entry.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 64 },
        "sectionId": { "type": "string", "maxLength": 64 },
        "day": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "roomOrMode": { "type": "string", "maxLength": 80 }
      },
      "required": ["classId", "day", "startTime", "endTime", "subjectName"]
    },
    "HomeworkItem": {
      "title": "HomeworkItem",
      "description": "Class-wise homework task.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "attachmentUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["title", "classId", "subjectName", "dueDate"]
    },
    "AssignmentItem": {
      "title": "AssignmentItem",
      "description": "Graded subject assignment.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "maxMarks": { "type": "number" },
        "teacherUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["title", "classId", "subjectName", "dueDate", "maxMarks"]
    },
    "SubmissionItem": {
      "title": "SubmissionItem",
      "description": "Student homework/assignment submission.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "submissionText": { "type": "string", "maxLength": 3000 },
        "fileUrl": { "type": "string", "maxLength": 500 },
        "marks": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["submitted", "late", "evaluated"] }
      },
      "required": ["assignmentId", "studentUid", "status"]
    },
    "ExaminationRecord": {
      "title": "ExaminationRecord",
      "description": "Exam configuration for a session and class.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "examType": { "type": "string", "maxLength": 80 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "classId": { "type": "string", "maxLength": 64 },
        "startDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["scheduled", "marks_entry", "approved", "published"] }
      },
      "required": ["title", "examType", "sessionId", "classId", "status"]
    },
    "MarkEntry": {
      "title": "MarkEntry",
      "description": "Subject-wise marks for an examination.",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "track": { "type": "string", "enum": ["general", "islamic"] },
        "fullMarks": { "type": "number" },
        "passMarks": { "type": "number" },
        "obtainedMarks": { "type": "number" },
        "verified": { "type": "boolean" }
      },
      "required": ["examId", "studentId", "subjectName", "fullMarks", "obtainedMarks"]
    },
    "PublishedResult": {
      "title": "PublishedResult",
      "description": "Approved non-PII examination result for marksheet portal.",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 160 },
        "studentName": { "type": "string", "maxLength": 120 },
        "fatherName": { "type": "string", "maxLength": 120 },
        "admissionNumber": { "type": "string", "maxLength": 40 },
        "rollNumber": { "type": "string", "maxLength": 30 },
        "classId": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "subjects": { "type": "array" },
        "totalMarks": { "type": "number" },
        "fullMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "resultStatus": { "type": "string", "enum": ["Passed", "Compartment", "Needs Improvement"] },
        "remarks": { "type": "string", "maxLength": 300 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["studentName", "rollNumber", "classId", "sessionId", "isPublished", "resultStatus"]
    },
    "FeeStructure": {
      "title": "FeeStructure",
      "description": "Configurable fee template per class and category.",
