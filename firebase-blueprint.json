        "amount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["Unpaid", "Partial", "Paid"] }
      },
      "required": ["invoiceNumber", "studentId", "amount", "status"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Fee payment receipt record.",
