        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "issuedDate": { "type": "string", "maxLength": 30 },
        "issuedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["certificateNumber", "templateType", "studentId", "studentName"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "read"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable security and operational audit log.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "maxLength": 120 },
        "collectionName": { "type": "string", "maxLength": 80 },
        "documentId": { "type": "string", "maxLength": 128 },
        "detail": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "collectionName", "createdAt"]
    }
  },
