{
  "firestore": {
    "database": "ai-studio-assiddiqueislami-9f6874df-3ab3-47d1-8a0a-587cd48d2926",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "gen-lang-client-0175021821",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "as-siddique-academy-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/robots.txt",
        "run": {
          "serviceId": "as-siddique-academy-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "as-siddique-academy-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/src/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
